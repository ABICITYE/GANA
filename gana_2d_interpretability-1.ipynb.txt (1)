  },\n","    \"small_mlp_bn\": {\n","      \"coherence\": 0.696875,\n","      \"shuffle_mean\": 0.13199999999999998,\n","      \"shuffle_std\": 0.022896335678444273,\n","      \"z_score\": 24.670967495559808\n","    },\n","    \"full_gana\": {\n","      \"coherence\": 0.1296875,\n","      \"shuffle_mean\": 0.11018750000000002,\n","      \"shuffle_std\": 0.015206071464221125,\n","      \"z_score\": 1.2823816606455887\n","    },\n","    \"full_gana_abl\": {\n","      \"coherence\": 0.140625,\n","      \"shuffle_mean\": 0.12121874999999999,\n","      \"shuffle_std\": 0.01617044830663331,\n","      \"z_score\": 1.2001051319639682\n","    },\n","    \"full_mlp_bn\": {\n","      \"coherence\": 0.8578125,\n","      \"shuffle_mean\": 0.17295312500000004,\n","      \"shuffle_std\": 0.01966354569493699,\n","      \"z_score\": 34.82886745535746\n","    }\n","  },\n","  \"mean_selectivity\": {\n","    \"small_gana\": 0.5036568579355934,\n","    \"small_gana_abl\": 0.4890538607634102,\n","    \"small_mlp_bn\": 0.6635920154314804,\n","    \"full_gana\": 0.5062560055054609,\n","    \"full_gana_abl\": 0.5113139650200242,\n","    \"full_mlp_bn\": 0.6535400256938566\n","  }\n","}\n","\n","Saved: fig_2d_neuron_maps.png, fig_selectivity_dist.png, fig_heatmap_*.png, gana_2d_results.json, model_*.pt\n"]}],"source":["import json\n","summary = {\n","    'epochs': EPOCHS,\n","    'final_test_acc': {name: results[name]['history']['test_acc'][-1] for name in configs},\n","    'spatial_coherence': {name: {'coherence': float(v[0]), 'shuffle_mean': float(v[1]),\n","                                  'shuffle_std': float(v[2]), 'z_score': float(v[3])}\n","                          for name, v in coherence_table.items()},\n","    'mean_selectivity': {name: float(neuron_data[name][3].mean()) for name in configs},\n","}\n","with open('gana_2d_results.json', 'w') as f:\n","    json.dump(summary, f, indent=2)\n","print(json.dumps(summary, indent=2))\n","\n","# Save model weights too\n","for name in configs:\n","    torch.save(results[name]['model'].state_dict(), f'model_{name}.pt')\n","print('\\nSaved: fig_2d_neuron_maps.png, fig_selectivity_dist.png, fig_heatmap_*.png, gana_2d_results.json, model_*.pt')"],"id":"af2a_NiA5MLU"},{"cell_type":"markdown","metadata":{"id":"hiWcwIvf5MLV"},"source":["## Interpretation cheat-sheet\n","\n","**Strong result for the paper:**\n","- `full_gana` and `small_gana` show clear color clusters in panel 1 of the main figure\n","- Coherence Z-scores for GANA models are well above ablated and MLP baselines (Z > 5 ideal)\n","- GANA test accuracy holds up despite the ed=2 constraint (expect 95%+ on full, 92%+ on small)\n","\n","**Honest negative result (also publishable):**\n","- If GANA and ablated look similar visually but coherence Z is higher for GANA, the geometry is doing real work even if it's not visually striking\n","- If both look like confetti and Z-scores are near zero, the curvature term isn't organizing space — you'd need to report this and reconsider what the ed=16 winning runs are actually doing\n","\n","**Phase 2 (paper writing) follow-ups this experiment feeds:**\n","- Figure 3 candidate: the 6-panel neuron map\n","- Table candidate: spatial coherence Z-scores\n","- Discussion: the gap between GANA and GANA-ablated is the cleanest evidence that curvature dynamics, not just architecture, drive the Phase 1 results"],"id":"hiWcwIvf5MLV"}],"metadata":{"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.10"},"colab":{"provenance":[],"gpuType":"T4"},"accelerator":"GPU"},"nbformat":4,"nbformat_minor":5}